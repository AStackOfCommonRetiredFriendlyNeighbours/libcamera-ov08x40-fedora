+                                context.configuration.agc.exposureMin,
+                                maxExposure / context.configuration.agc.lineDuration);
+
+                context.configuration.agc.exposureMax =
+                        std::min(context.configuration.agc.exposureMax,
+                                 maxExposureLines);
+        }
+
+        return 0;
+}
