+        auto maxExposureTimeMs = tuningData["maxExposureTimeMs"].get<double>();
+        if (maxExposureTimeMs.has_value())
+                maxExposureTimeMs_ = std::max(1.0, maxExposureTimeMs.value());
+
+        return 0;
